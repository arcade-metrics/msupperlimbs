# Postgres local (teamap_db) — desenvolvimento
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/teamap_db

# Em produção: gera um segredo longo (ex. python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=dev-secret-change-me

# Lista separada por vírgulas, ou * só em dev
CORS_ORIGINS=*

# Opcionais (defaults no código)
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30
